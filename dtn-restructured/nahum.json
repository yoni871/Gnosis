{
  "book": "Nahum",
  "commentary": "Darby Translation Notes",
  "author": "John Nelson Darby",
  "entries": [
    {
      "start_chapter": 1,
      "start_verse": 1,
      "end_chapter": 1,
      "end_verse": 1,
      "title": "",
      "content": "(h-0) * (The title of this book, 'Nahum'), Said to mean 'Comfort' or 'Comforted.'"
    },
    {
      "start_chapter": 1,
      "start_verse": 7,
      "end_chapter": 1,
      "end_verse": 7,
      "title": "",
      "content": "trouble; (a-10) Or 'distress,' as Gen. 35.3."
    },
    {
      "start_chapter": 1,
      "start_verse": 8,
      "end_chapter": 1,
      "end_verse": 8,
      "title": "",
      "content": "end (b-11) See Zeph. 1.18. thereof, (c-15) i.e. of Nineveh."
    },
    {
      "start_chapter": 1,
      "start_verse": 9,
      "end_chapter": 1,
      "end_verse": 9,
      "title": "",
      "content": "end. (b-12) See Zeph. 1.18."
    },
    {
      "start_chapter": 1,
      "start_verse": 11,
      "end_chapter": 1,
      "end_verse": 11,
      "title": "",
      "content": "counsellor. (d-15) Lit. 'a counsellor of Belial.'"
    },
    {
      "start_chapter": 1,
      "start_verse": 12,
      "end_chapter": 1,
      "end_verse": 12,
      "title": "",
      "content": "thee, (e-32) i.e. Judah. see ver. 15."
    },
    {
      "start_chapter": 1,
      "start_verse": 14,
      "end_chapter": 1,
      "end_verse": 14,
      "title": "",
      "content": "thee, (f-7) i.e. the Assyrian, 'the wicked one,' ch. 1.15."
    },
    {
      "start_chapter": 1,
      "start_verse": 15,
      "end_chapter": 1,
      "end_verse": 15,
      "title": "",
      "content": "(g-0) In the Hebrew, ch. 2 begins here. one (h-26) Lit. 'Belial.'"
    },
    {
      "start_chapter": 2,
      "start_verse": 1,
      "end_chapter": 2,
      "end_verse": 1,
      "title": "",
      "content": "pieces (i-5) Or 'The maul.'"
    },
    {
      "start_chapter": 2,
      "start_verse": 2,
      "end_chapter": 2,
      "end_verse": 2,
      "title": "",
      "content": "again (k-5) Or 'hath returned to.' Israel; (l-14) Or 'hath turned away the pride of Jacob as the pride of Israel.' them, (m-20) Or 'the emptiers have emptied them out.'"
    },
    {
      "start_chapter": 2,
      "start_verse": 3,
      "end_chapter": 2,
      "end_verse": 3,
      "title": "",
      "content": "his (n-4) i.e. of Jehovah, who sends them to besiege Nineveh. sheen (o-21) Lit. 'fire.' spears (p-32) Lit. 'cypresses.'"
    },
    {
      "start_chapter": 2,
      "start_verse": 5,
      "end_chapter": 2,
      "end_verse": 5,
      "title": "",
      "content": "He (f-1) i.e. the Assyrian, 'the wicked one,' ch. 1.15. shelter (q-21) Shelter for the besieged."
    },
    {
      "start_chapter": 2,
      "start_verse": 7,
      "end_chapter": 2,
      "end_verse": 7,
      "title": "",
      "content": "she (r-5) i.e. Nineveh. breasts. (s-28) Lit. 'hearts.'"
    },
    {
      "start_chapter": 3,
      "start_verse": 8,
      "end_chapter": 3,
      "end_verse": 8,
      "title": "",
      "content": "No-Amon, (a-5) i.e. the god Amon of No (Thebes) in Egypt. rivers, (b-11) Or 'canals.'"
    },
    {
      "start_chapter": 3,
      "start_verse": 9,
      "end_chapter": 3,
      "end_verse": 9,
      "title": "",
      "content": "Ethiopia (c-1) 'Cush.' infinite; (d-10) Or 'endless.' her (e-16) Lit. 'thy,' but referring here to No-Amon, which is apostrophised."
    },
    {
      "start_chapter": 3,
      "start_verse": 11,
      "end_chapter": 3,
      "end_verse": 11,
      "title": "",
      "content": "hid; (f-9) Or 'shalt hide thyself.'"
    },
    {
      "start_chapter": 3,
      "start_verse": 15,
      "end_chapter": 3,
      "end_verse": 15,
      "title": "",
      "content": "cankerworm. (g-19) See Joel 1.4."
    },
    {
      "start_chapter": 3,
      "start_verse": 17,
      "end_chapter": 3,
      "end_verse": 17,
      "title": "",
      "content": "grasshoppers, (h-14) Heb. gob gobai, lit. 'grasshopper of grasshoppers,' -- probably a species of locust which issues from the ground when hatched; not as Ex. 10.13."
    }
  ]
}
