{
  "book": "Ruth",
  "commentary": "Darby Translation Notes",
  "author": "John Nelson Darby",
  "entries": [
    {
      "start_chapter": 1,
      "start_verse": 1,
      "end_chapter": 1,
      "end_verse": 1,
      "title": "",
      "content": "ruled, (a-12) Shaphat, lit. 'judged.' country (b-32) Lit. 'fields,' 'farmlands,' as ver. 6, and elsewhere. As 2 Kings 8.3,5."
    },
    {
      "start_chapter": 1,
      "start_verse": 2,
      "end_chapter": 1,
      "end_verse": 2,
      "title": "",
      "content": "Elimelech, (c-8) Meaning, 'whose God is king.' Naomi, (d-15) Meaning, 'my pleasantness.'"
    },
    {
      "start_chapter": 1,
      "start_verse": 20,
      "end_chapter": 1,
      "end_verse": 20,
      "title": "",
      "content": "Mara; (a-13) Meaning, 'bitter,' or 'bitterness.'"
    },
    {
      "start_chapter": 2,
      "start_verse": 1,
      "end_chapter": 2,
      "end_verse": 1,
      "title": "",
      "content": "relation (b-5) Or 'friend,' 'acquaintance.' Boaz. (c-23) Meaning, 'in him is strength.'"
    },
    {
      "start_chapter": 2,
      "start_verse": 3,
      "end_chapter": 2,
      "end_verse": 3,
      "title": "",
      "content": "allotment (d-22) Lit. 'portion of [the] field.'"
    },
    {
      "start_chapter": 2,
      "start_verse": 5,
      "end_chapter": 2,
      "end_verse": 5,
      "title": "",
      "content": "servant (e-6) Or 'young man.' also ver. 6, as Judg. 19.3 and 9."
    },
    {
      "start_chapter": 2,
      "start_verse": 10,
      "end_chapter": 2,
      "end_verse": 10,
      "title": "",
      "content": "foreigner? (f-34) Or 'stranger.'"
    },
    {
      "start_chapter": 2,
      "start_verse": 13,
      "end_chapter": 2,
      "end_verse": 13,
      "title": "",
      "content": "to (g-26) Lit. 'spoken to the heart of.' handmaid, (h-28) Or 'bondwoman.'"
    },
    {
      "start_chapter": 2,
      "start_verse": 16,
      "end_chapter": 2,
      "end_verse": 16,
      "title": "",
      "content": "out (a-7) According to others, 'let fall.' handfuls, (b-15) Or 'sheaves;' the word is only found in this place."
    },
    {
      "start_chapter": 2,
      "start_verse": 20,
      "end_chapter": 2,
      "end_verse": 20,
      "title": "",
      "content": "redemption. (c-48) See Lev. 25.25."
    },
    {
      "start_chapter": 3,
      "start_verse": 3,
      "end_chapter": 3,
      "end_verse": 3,
      "title": "",
      "content": "Wash (d-1) Or 'bathe,' as elsewhere."
    },
    {
      "start_chapter": 3,
      "start_verse": 9,
      "end_chapter": 3,
      "end_verse": 9,
      "title": "",
      "content": "skirt (e-17) Lit. 'wing,' as Ex. 19.4; Ps. 36.7."
    },
    {
      "start_chapter": 3,
      "start_verse": 15,
      "end_chapter": 3,
      "end_verse": 15,
      "title": "",
      "content": "went (a-33) Some read 'she went.'"
    },
    {
      "start_chapter": 4,
      "start_verse": 4,
      "end_chapter": 4,
      "end_verse": 4,
      "title": "",
      "content": "thought (b-3) Lit. 'said.' thee (c-7) Lit. 'uncover thine ear.' so in 1Sam. 9.15; 20.2,12,13. inhabitants, (d-19) Or 'before those that sit here.'"
    },
    {
      "start_chapter": 4,
      "start_verse": 5,
      "end_chapter": 4,
      "end_verse": 5,
      "title": "",
      "content": "field (e-10) As 'country,' ch. 1.1."
    },
    {
      "start_chapter": 4,
      "start_verse": 14,
      "end_chapter": 4,
      "end_verse": 14,
      "title": "",
      "content": "redemption, (a-24) Or 'without a redeemer;' it refers to the son born, i.e. Obed."
    },
    {
      "start_chapter": 4,
      "start_verse": 17,
      "end_chapter": 4,
      "end_verse": 17,
      "title": "",
      "content": "Obed. (b-23) Meaning, 'worshipper' or 'servant.'"
    },
    {
      "start_chapter": 4,
      "start_verse": 18,
      "end_chapter": 4,
      "end_verse": 18,
      "title": "",
      "content": "generations (c-5) As Gen. 2.4"
    },
    {
      "start_chapter": 4,
      "start_verse": 20,
      "end_chapter": 4,
      "end_verse": 20,
      "title": "",
      "content": "Salmon, (d-8) Or Salma."
    }
  ]
}
