    {
      "start_chapter": 2,
      "start_verse": 14,
      "end_chapter": 2,
      "end_verse": 14,
      "title": "",
      "content": "offer (a-31) Lit. 'they present,' as Lev. 1.2; 7.12, &c."
    },
