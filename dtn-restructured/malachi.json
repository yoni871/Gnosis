{
  "book": "Malachi",
  "commentary": "Darby Translation Notes",
  "author": "John Nelson Darby",
  "entries": [
    {
      "start_chapter": 1,
      "start_verse": 1,
      "end_chapter": 1,
      "end_verse": 1,
      "title": "",
      "content": "(e-0) * (The title of this Book, 'Malachi'), Said to mean, 'Messenger of Jah.'"
    },
    {
      "start_chapter": 1,
      "start_verse": 7,
      "end_chapter": 1,
      "end_verse": 7,
      "title": "",
      "content": "offer (f-2) Lit. 'bring near,' as vers. 8,11; chs. 2.12; 3.3, Lev. 2.8. see 1Sam. 13.9, 'hither.'"
    },
    {
      "start_chapter": 1,
      "start_verse": 10,
      "end_chapter": 1,
      "end_verse": 10,
      "title": "",
      "content": "accept (a-36) Or 'be pleased with,' as ver. 8."
    },
    {
      "start_chapter": 1,
      "start_verse": 12,
      "end_chapter": 1,
      "end_verse": 12,
      "title": "",
      "content": "Lord (b-13) Some read 'Jehovah.'"
    },
    {
      "start_chapter": 1,
      "start_verse": 13,
      "end_chapter": 1,
      "end_verse": 13,
      "title": "",
      "content": "accept (a-38) Or 'be pleased with,' as ver. 8. torn, (c-24) Or 'violently taken away.'"
    },
    {
      "start_chapter": 1,
      "start_verse": 14,
      "end_chapter": 1,
      "end_verse": 14,
      "title": "",
      "content": "terrible (d-37) Or 'to be revered.' see Ps. 111.9."
    },
    {
      "start_chapter": 2,
      "start_verse": 7,
      "end_chapter": 2,
      "end_verse": 7,
      "title": "",
      "content": "seek (e-13) Or 'should seek.' messenger (f-20) Malach, i.e. messenger or angel."
    },
    {
      "start_chapter": 2,
      "start_verse": 11,
      "end_chapter": 2,
      "end_verse": 11,
      "title": "",
      "content": "sanctuary (g-20) Elsewhere 'holy place' or 'holy thing.'"
    },
    {
      "start_chapter": 2,
      "start_verse": 12,
      "end_chapter": 2,
      "end_verse": 12,
      "title": "",
      "content": "answereth; (h-21) A circumlocution for 'all.'"
    },
    {
      "start_chapter": 2,
      "start_verse": 13,
      "end_chapter": 2,
      "end_verse": 13,
      "title": "",
      "content": "further (i-2) Or 'secondly.'"
    },
    {
      "start_chapter": 2,
      "start_verse": 15,
      "end_chapter": 2,
      "end_verse": 15,
      "title": "",
      "content": "[them]? (a-6) Or 'did he not make [them] one thing?' one? (b-18) Or 'one thing.' The application of this passage to Abraham, which some insist on, is not to be admitted."
    },
    {
      "start_chapter": 2,
      "start_verse": 16,
      "end_chapter": 2,
      "end_verse": 16,
      "title": "",
      "content": "garment, (c-18) Or 'who multiplies violence on his wife.'"
    },
    {
      "start_chapter": 3,
      "start_verse": 1,
      "end_chapter": 3,
      "end_verse": 1,
      "title": "",
      "content": "messenger, (d-5) Angel (d-28) Malach, i.e. messenger or angel. covenant, (e-31) See Ex. 32.34."
    },
    {
      "start_chapter": 3,
      "start_verse": 2,
      "end_chapter": 3,
      "end_verse": 2,
      "title": "",
      "content": "endure (f-4) Or 'be fit for.'"
    },
    {
      "start_chapter": 3,
      "start_verse": 5,
      "end_chapter": 3,
      "end_verse": 5,
      "title": "",
      "content": "oppress (g-33) Or 'defraud.' see Note, Lev. 6.2. right], (h-53) Or 'wrest the judgment of the stranger.'"
    },
    {
      "start_chapter": 3,
      "start_verse": 10,
      "end_chapter": 3,
      "end_verse": 10,
      "title": "",
      "content": "it. (i-48) Or 'a blessing, to superabundance.'"
    },
    {
      "start_chapter": 3,
      "start_verse": 17,
      "end_chapter": 3,
      "end_verse": 17,
      "title": "",
      "content": "treasure, (a-9) Or 'my own possession,' as Ex. 19.5."
    },
    {
      "start_chapter": 3,
      "start_verse": 18,
      "end_chapter": 3,
      "end_verse": 18,
      "title": "",
      "content": "discern (b-6) Or 'shall again discern.'"
    },
    {
      "start_chapter": 4,
      "start_verse": 6,
      "end_chapter": 4,
      "end_verse": 6,
      "title": "",
      "content": "earth (c-28) Or 'the land.' curse. (d-31) Or 'ban,' as Isa. 34.5; 43.28; or 'utter destruction,' as Zech. 14.11."
    }
  ]
