# Normal application credentials; keep the application role least-privileged.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gnosis_local
DB_USER=bible_app
DB_PASSWORD=

# Local migration connections use ONLY these separate operator credentials.
# All five must be explicitly set, including a nonempty password.
# Add real values privately in backend/.env or your secure environment; never commit them.
MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=5432
MIGRATION_DB_NAME=gnosis_local
MIGRATION_DB_USER=your_local_migration_role
MIGRATION_DB_PASSWORD=

# Production: inject MIGRATION_DATABASE_URL securely into the release environment.
# Use a direct Neon endpoint with sslmode=verify-full. Never commit actual values.
# MIGRATION_CONFIRM_PRODUCTION=yes is required for writes after operator review.
# Tests: follow docs/Database_Migrations.md for a fresh disposable local cluster.

# Authentication rate limiting (issue #4). The server refuses to start
# without RATE_LIMIT_KEY_SECRET; set a dedicated random secret, distinct
# from JWT_SECRET, privately in backend/.env or your secure environment.
# TRUST_PROXY stays disabled by default; set it only to the value matching
# the backend host's verified proxy chain. Never commit real values.
RATE_LIMIT_KEY_SECRET=
TRUST_PROXY=false

# Email verification (issue #9). The server refuses to start without
# these three. Set them privately in backend/.env or your secure
# environment; never commit real values. Changing to a future custom
# domain requires only: verify the domain in Resend, change EMAIL_FROM
# (and FRONTEND_URL if the website origin changes), and redeploy. No code
# edit, migration, or user-account change is needed for a domain change.
# RESEND_API_KEY is the Resend API key with sending access only.
# EMAIL_FROM is the sender address on a verified Resend domain (a bare
# address or "Display Name <address>"). Before a custom domain exists,
# onboarding@resend.dev may be used only for a manual smoke test to the
# Resend account's own email; it cannot deliver to ordinary users and
# must never be relied on for production.
# FRONTEND_URL is the deployed frontend origin (absolute HTTPS); verify
# links are built from it.
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_URL=
# Test-only override, honored only when GNOSIS_TEST_ISOLATION=1.
# Production always uses https://api.resend.com; never set this in
# production.
# RESEND_API_BASE_URL=
