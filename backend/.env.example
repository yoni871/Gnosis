# npm run local:setup copies this to .env.local and generates the four blank secrets.
# npm run dev uses only .env.local, never the existing .env.
# GNOSIS_LOCAL_DEV is set by the local launcher; never set it in production.
# JWT_SECRET and RATE_LIMIT_KEY_SECRET must each be at least 32 random
# bytes (audit N06): 64 hex characters, or at least 43 base64url
# characters, or otherwise at least 32 characters. The server refuses to
# boot with a shorter value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Deployed secrets must be shown to meet this bar or rotated (operator
# step; rotation alone does not revoke sessions).
NODE_ENV=development
PORT=5000
JWT_SECRET=
RATE_LIMIT_KEY_SECRET=
# TRUST_PROXY is a hop count (1-5) or a comma-separated list of trusted proxy
# IPs/CIDRs in production — never "true" (rejected at boot: it trusts every
# hop and lets any client spoof its IP). On Vercel use 1 and confirm it with
# the live spoof check (see the #115 PR body): if the observed client IP is a
# Vercel egress IP instead of the real client IP, raise the count to 2.
# Optional TOTP MFA encryption key: 32 random bytes as 64 hex characters
# (or 44 base64 characters). Enrolled authenticator secrets are
# encrypted with it (AES-256-GCM). MFA is optional, so the server still
# boots without it — but enrollment and MFA login then fail closed with
# a controlled 503. Never derive it from JWT_SECRET. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Key rotation: see the MFA design doc §3 (MFA-Recovery-Key-Rotation-
# Design.md). Never rotate by replacing this value alone — stage the
# old key as MFA_ENCRYPTION_KEY_PREVIOUS, set MFA_KEY_VERSION to the
# new version, run backend/scripts/db/rotate-mfa-key.js as the owner,
# then remove the previous key. Replacing this value without that
# process orphans enrolled secrets (re-enrollment required).
MFA_ENCRYPTION_KEY=
# Previous MFA encryption key, staged only during a rotation (design
# §3). Same format as MFA_ENCRYPTION_KEY. Set it only while rotating;
# remove it once every enrolled row is at the new key version.
# MFA_ENCRYPTION_KEY_PREVIOUS=
# MFA key version: the integer version of MFA_ENCRYPTION_KEY (design
# §3). 1 is the original key; increment it when staging a rotation
# key. New enrollments record this version; the decryptor selects the
# matching key, so old and new keys work side by side during the
# transition. Default 1 when unset.
# MFA_KEY_VERSION=1
# Admin accounts that must have MFA enrolled (design §9): a
# comma-separated list of lowercase emails, set per scope in Vercel.
# An admin without enrolled MFA gets no session at login — instead a
# 403 MFA_ENROLLMENT_REQUIRED with a short-lived enrollment token.
# Regular users are unaffected. Empty means no admins.
# ADMIN_EMAILS=
TRUST_PROXY=false
FRONTEND_URL=http://localhost:5173
# Local-only Mailpit captures verification emails at http://localhost:8025.
# No external delivery. disabled and resend remain explicit alternatives.
EMAIL_DELIVERY=mailpit
RESEND_API_KEY=
# Sender: when EMAIL_FROM is blank, the backend uses the product identity
# Gnosis <noreply@mail.studygnosis.com> (issue #118). Set EMAIL_FROM only to
# override it per deployment; a provided-but-invalid address fails boot.
EMAIL_FROM=
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=gnosis_local
DB_USER=gnosis_reader
DB_PASSWORD=
MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=55432
MIGRATION_DB_NAME=gnosis_local
MIGRATION_DB_USER=gnosis_local_owner
MIGRATION_DB_PASSWORD=
# Never set DATABASE_URL for local development. Production may use DATABASE_URL
# instead of DB_*. Production requires NODE_ENV=production, HTTPS FRONTEND_URL,
# RESEND_API_KEY, valid EMAIL_FROM, JWT_SECRET and RATE_LIMIT_KEY_SECRET.
# Optional licensed providers (not needed for bundled KJV/ASV):
ESV_API_KEY=
API_BIBLE_KEY=
API_BIBLE_NIV_ID=
API_BIBLE_NKJV_ID=
# Optional NASB ID override; built-in default exists.
API_BIBLE_NASB_ID=
NLT_API_KEY=
# Operator-only production migration settings (never used locally):
# MIGRATION_APP_DATABASE_URL=
# MIGRATION_BIBLE_DATABASE_URL=
# MIGRATION_COMMENTARY_DATABASE_URL=
# MIGRATION_CONFIRM_PRODUCTION=yes
# Runtime split (three Neon projects). Set the three GNOSIS_*_DATABASE_URL
# values in the deployment environment to split the projects; when unset,
# all three pools fall back to DATABASE_URL (single-database mode).
# GNOSIS_APP_DATABASE_URL=
# GNOSIS_BIBLE_DATABASE_URL=
# GNOSIS_COMMENTARY_DATABASE_URL=
# Set GNOSIS_SPLIT_REQUIRED=1 only at the cutover, once all three URLs
# above are set: the backend then fails to boot instead of silently
# falling back to DATABASE_URL if a split URL is missing or misspelled.
# GNOSIS_SPLIT_REQUIRED=
# RESEND_API_BASE_URL is TEST ONLY; never configure in application environments.
