# Normal application credentials; keep the application role least-privileged.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gnosis_local
DB_USER=bible_app
DB_PASSWORD=

# Local migration connections use ONLY these separate operator credentials.
# All five must be explicitly set, including a nonempty password.
# Add real values privately in backend/.env or your secure environment; never commit them.
MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=5432
MIGRATION_DB_NAME=gnosis_local
MIGRATION_DB_USER=your_local_migration_role
MIGRATION_DB_PASSWORD=

# Production: inject MIGRATION_DATABASE_URL securely into the release environment.
# Use a direct Neon endpoint with sslmode=verify-full. Never commit actual values.
# MIGRATION_CONFIRM_PRODUCTION=yes is required for writes after operator review.
# Tests: follow docs/Database_Migrations.md for a fresh disposable local cluster.
