# Local migration commands require --target local and these explicit values.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gnosis_local
DB_USER=your_local_role
DB_PASSWORD=
# Production: inject MIGRATION_DATABASE_URL securely into the release environment.
# Use a direct Neon endpoint with sslmode=verify-full. Never commit actual values.
# MIGRATION_CONFIRM_PRODUCTION=yes is required for writes after operator review.
# Tests: follow docs/Database_Migrations.md for a fresh disposable local cluster.
