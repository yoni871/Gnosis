  {
    "kind": "function",
    "name": "update_bible_search_vector()",
    "definition": {
      "sql": "CREATE OR REPLACE FUNCTION public.update_bible_search_vector()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n    NEW.search_vector := to_tsvector(\n        'english',\n        COALESCE(NEW.text, '')\n    );\n\n    RETURN NEW;\nEND;\n$function$\n"
    }
  },
  {
    "kind": "function",
    "name": "update_commentary_search_vector()",
    "definition": {
      "sql": "CREATE OR REPLACE FUNCTION public.update_commentary_search_vector()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n    NEW.search_vector := to_tsvector(\n        'english',\n        COALESCE(NEW.title, '') || ' ' || COALESCE(NEW.content, '')\n    );\n\n    RETURN NEW;\nEND;\n$function$\n"
    }
  },
